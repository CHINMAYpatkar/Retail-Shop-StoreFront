# Public API base. Everything the storefront renders comes from here - there is
# no hardcoded content, so with the API down the site has nothing to show.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Origin the backend serves uploaded media from. Kept separate from the API base
# because media sits outside the API prefix: those are files, not API resources.
NEXT_PUBLIC_MEDIA_URL=http://localhost:4000

# Canonical origin, used for absolute URLs in metadata and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
